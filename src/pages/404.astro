---
// Shown by Cloudflare Pages for any address that doesn't exist. Albanian first, English underneath.
import Base from '../layouts/Base.astro';
import { contact } from '../data/content';
---
<Base lang="sq" title="Faqja nuk u gjet | EV COMPANY sh.p.k." notFound>
  <header class="site-header is-solid legal-header">
    <a class="site-header__brand" href="/sq/" aria-label="EV COMPANY sh.p.k."><img src="/ev-company-mark.svg" alt="" width="96" height="74" /></a>
    <span></span>
    <div class="lang">
      <a href="/sq/" lang="sq">SQ</a>
      <a href="/en/" lang="en">EN</a>
    </div>
  </header>
  <main id="main" class="nf wrap">
    <button class="breaker breaker--main nf__switch" type="button" aria-pressed="false" data-nf-switch data-href="/sq/">
      <span class="breaker__label">404</span>
      <span class="breaker__body" aria-hidden="true">
        <span class="breaker__led"></span>
        <span class="breaker__mark breaker__mark--on">I</span>
        <span class="breaker__slot"><span class="breaker__lever"></span></span>
        <span class="breaker__mark breaker__mark--off">O</span>
      </span>
      <span class="visually-hidden">Ndize dhe kthehu në faqen kryesore</span>
    </button>
    <div class="nf__text">
      <h1 class="nf__title">Kjo faqe nuk ka rrymë.</h1>
      <p class="nf__lead">Faqja që kërkuat nuk ekziston ose është zhvendosur.</p>
      <div class="nf__actions">
        <a class="btn btn--glow" href="/sq/"><span>Kthehu në faqen kryesore</span></a>
        <a class="text-link" href={contact.phoneHref} data-c-phone>{contact.phoneDisplay}</a>
      </div>
      <p class="nf__en" lang="en">This page has no power: it doesn't exist or has moved. <a href="/en/">Go to the English site</a></p>
    </div>
  </main>
  <script is:inline>
    (function () {
      var b = document.querySelector('[data-nf-switch]');
      if (!b) return;
      b.addEventListener('click', function () {
        b.setAttribute('aria-pressed', 'true');
        setTimeout(function () { location.href = b.getAttribute('data-href'); }, 550);
      });
    })();
  </script>
</Base>
