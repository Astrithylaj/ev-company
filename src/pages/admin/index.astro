---
// Admin panel for EV COMPANY. Protected by Cloudflare Access (email code) + a server-side check in functions/_middleware.ts.
import '@fontsource-variable/archivo/wdth.css';
import '../../styles/admin.css';
import { content } from '../../data/content';
const services = content.sq.services.list.map((s) => ({ id: s.id, label: s.short }));
---
<!doctype html>
<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0c0e" />
    <title>Paneli i administrimit | EV COMPANY</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <img class="top__logo" src="/ev-company-mark.svg" alt="EV COMPANY" width="64" height="49" />
      <div class="top__title">
        <strong>Paneli i administrimit</strong>
        <span data-user></span>
      </div>
      <nav class="top__links">
        <a href="/sq/" target="_blank" rel="noopener">Shiko faqen</a>
        <a href="/cdn-cgi/access/logout">Dil</a>
      </nav>
    </header>

    <nav class="tabs-wrap" aria-label="Seksionet">
    <div class="tabs" role="tablist">
      <button role="tab" id="t-projects" aria-controls="p-projects" aria-selected="true" data-tab="projects">Projektet</button>
      <button role="tab" id="t-contact" aria-controls="p-contact" aria-selected="false" tabindex="-1" data-tab="contact">Kontakti</button>
      <button role="tab" id="t-social" aria-controls="p-social" aria-selected="false" tabindex="-1" data-tab="social">Rrjetet sociale</button>
      <button role="tab" id="t-banner" aria-controls="p-banner" aria-selected="false" tabindex="-1" data-tab="banner">Njoftimi</button>
    </div>
    </nav>

    <main class="main">
      <p class="loading" data-loading>Duke ngarkuar…</p>

      <!-- PROJECTS -->
      <section id="p-projects" role="tabpanel" aria-labelledby="t-projects" class="panel" hidden>
        <div data-list-view>
          <div class="panel__head">
            <div>
              <h1>Projektet</h1>
              <p class="hint">Projektet që shfaqen te seksioni “Projektet” në faqe. Renditja këtu është renditja në faqe.</p>
            </div>
            <button class="btn btn--primary" type="button" data-add>Shto projekt</button>
          </div>
          <ul class="plist" data-plist></ul>
          <p class="empty" data-empty hidden>Ende nuk ka projekte. Shtypni “Shto projekt” për të shtuar të parin. Seksioni shfaqet në faqe sapo të ketë të paktën një projekt të dukshëm.</p>
        </div>

        <form class="editor" data-editor hidden novalidate>
          <button class="back" type="button" data-back>Kthehu te lista</button>
          <h1 data-editor-title>Projekt i ri</h1>

          <fieldset class="group">
            <legend>Shqip</legend>
            <label class="f"><span>Titulli *</span><input id="e-sq-title" name="sq.title" maxlength="120" required placeholder="P.sh. Ndriçimi i rrugës “Agim Ramadani”" /></label>
            <div class="row2">
              <label class="f"><span>Vendi</span><input id="e-sq-place" name="sq.place" maxlength="80" placeholder="P.sh. Prishtinë" /></label>
              <label class="f"><span>Viti</span><input id="e-year" name="year" maxlength="10" inputmode="numeric" placeholder="2025" /></label>
            </div>
            <label class="f"><span>Klienti</span><input id="e-sq-client" name="sq.client" maxlength="120" placeholder="P.sh. Komuna e Prishtinës, ose “Klient privat”" /></label>
            <label class="f"><span>Përshkrimi</span><textarea id="e-sq-text" name="sq.text" maxlength="700" rows="3" placeholder="Çfarë u bë, me 1–2 fjali. P.sh. Montim i 40 shtyllave LED."></textarea></label>
          </fieldset>

          <details class="group group--en">
            <summary>English (opsionale)</summary>
            <p class="hint">Nëse e lini bosh, faqja në anglisht përdor tekstin shqip.</p>
            <label class="f"><span>Title</span><input id="e-en-title" name="en.title" maxlength="120" /></label>
            <label class="f"><span>Place</span><input id="e-en-place" name="en.place" maxlength="80" /></label>
            <label class="f"><span>Client</span><input id="e-en-client" name="en.client" maxlength="120" /></label>
            <label class="f"><span>Description</span><textarea id="e-en-text" name="en.text" maxlength="700" rows="3"></textarea></label>
          </details>

          <fieldset class="group">
            <legend>Shërbimet</legend>
            <div class="chips">
              {services.map((s) => (
                <label class="chip"><input type="checkbox" name="services" value={s.id} id={`e-svc-${s.id}`} /><span>{s.label}</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="group">
            <legend>Fotot</legend>
            <p class="hint">Deri në 12 foto. E para është kopertina. Fotot zvogëlohen automatikisht para ngarkimit.</p>
            <ul class="photos" data-photos></ul>
            <label class="upload">
              <input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-file id="e-file" />
              <span>Shto foto</span>
            </label>
            <p class="upload__status" role="status" data-upload-status></p>
          </fieldset>

          <fieldset class="group">
            <legend>Dukshmëria</legend>
            <label class="switch"><input type="checkbox" name="visible" id="e-visible" checked /><span>Shfaqe në faqe</span></label>
          </fieldset>

          <div class="editor__actions">
            <button class="btn btn--primary" type="button" data-done>Mbaro</button>
            <div class="danger" data-danger>
              <button class="btn btn--ghost-danger" type="button" data-delete>Fshije projektin</button>
              <span class="danger__confirm" data-delete-confirm hidden>
                Ta fshij? <button class="btn btn--danger" type="button" data-delete-yes>Po, fshije</button>
                <button class="btn btn--ghost" type="button" data-delete-no>Jo</button>
              </span>
            </div>
          </div>
        </form>
      </section>

      <!-- CONTACT -->
      <section id="p-contact" role="tabpanel" aria-labelledby="t-contact" class="panel" hidden>
        <h1>Kontakti</h1>
        <p class="hint">Ndryshon kudo në faqe: koka, butonat e thirrjes, seksioni i kontaktit, fundi i faqes dhe faqja e privatësisë.</p>
        <form class="group" data-form-contact novalidate>
          <label class="f"><span>Telefoni *</span><input id="c-phone" name="phone" inputmode="tel" maxlength="40" placeholder="+383 49 116 167" /></label>
          <label class="f"><span>Email *</span><input id="c-email" name="email" type="email" maxlength="120" /></label>
          <div class="row2">
            <label class="f"><span>Rruga</span><input id="c-street" name="street" maxlength="120" /></label>
            <label class="f"><span>Qyteti</span><input id="c-city" name="city" maxlength="80" /></label>
          </div>
          <label class="f"><span>Orari (shqip)</span><input id="c-hours-sq" name="hours.sq" maxlength="120" /></label>
          <label class="f"><span>Orari (anglisht)</span><input id="c-hours-en" name="hours.en" maxlength="120" /></label>
        </form>
      </section>

      <!-- SOCIAL -->
      <section id="p-social" role="tabpanel" aria-labelledby="t-social" class="panel" hidden>
        <h1>Rrjetet sociale</h1>
        <p class="hint">Lëreni bosh atë që nuk e përdorni: nuk shfaqet në faqe. WhatsApp shfaqet edhe si buton në telefon.</p>
        <form class="group" data-form-social novalidate>
          <label class="f"><span>WhatsApp (numri)</span><input id="s-whatsapp" name="whatsapp" inputmode="tel" maxlength="30" placeholder="+383 49 116 167" /></label>
          <label class="f"><span>Viber (numri)</span><input id="s-viber" name="viber" inputmode="tel" maxlength="30" placeholder="+383 49 116 167" /></label>
          <label class="f"><span>Facebook (lidhja)</span><input id="s-facebook" name="facebook" inputmode="url" maxlength="300" placeholder="https://facebook.com/…" /></label>
          <label class="f"><span>Instagram (lidhja)</span><input id="s-instagram" name="instagram" inputmode="url" maxlength="300" placeholder="https://instagram.com/…" /></label>
          <label class="f"><span>TikTok (lidhja)</span><input id="s-tiktok" name="tiktok" inputmode="url" maxlength="300" placeholder="https://tiktok.com/@…" /></label>
        </form>
      </section>

      <!-- BANNER -->
      <section id="p-banner" role="tabpanel" aria-labelledby="t-banner" class="panel" hidden>
        <h1>Njoftimi</h1>
        <p class="hint">Një mesazh i shkurtër që shfaqet mbi titullin kryesor të faqes. P.sh. orari i festave.</p>
        <form class="group" data-form-banner novalidate>
          <label class="switch"><input type="checkbox" name="on" id="b-on" /><span>Shfaq njoftimin</span></label>
          <label class="f"><span>Teksti (shqip) *</span><input id="b-sq" name="sq" maxlength="180" placeholder="P.sh. Më 25 tetor jemi të mbyllur." /></label>
          <label class="f"><span>Teksti (anglisht)</span><input id="b-en" name="en" maxlength="180" placeholder="E.g. Closed on 25 October." /></label>
          <label class="f f--short"><span>Shfaqe deri më (opsionale)</span><input id="b-until" name="until" type="date" /></label>
          <div class="preview" aria-hidden="true"><span>Parapamje</span><div class="notice-preview" data-banner-preview></div></div>
        </form>
      </section>
    </main>

    <div class="savebar" data-savebar>
      <p class="savebar__status" role="status" data-status>Të gjitha ndryshimet janë ruajtur.</p>
      <div class="savebar__actions">
        <button class="btn btn--ghost" type="button" data-restore hidden>Rikthe ndryshimet</button>
        <button class="btn btn--ghost" type="button" data-undo hidden>Kthe ruajtjen e fundit</button>
        <button class="btn btn--primary" type="button" data-save disabled>Ruaj ndryshimet</button>
      </div>
    </div>

    <script>
      import { startAdmin } from '../../scripts/admin';
      startAdmin();
    </script>
  </body>
</html>
