---
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import KosovoMap from '../../components/KosovoMap.astro';
import { exampleProjects } from '../../data/projects';
import { defaultContent, visibleProjects, renderProjects, renderSocial, renderBanner, renderMobileChat } from '../../lib/site';
import { legal } from '../../data/legal';
import { content, contact, type Lang } from '../../data/content';

export function getStaticPaths() {
  return [{ params: { lang: 'sq' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const t = content[lang];
const year = new Date().getFullYear();
const L = legal[lang];
const ids = { services: 'sherbimet', projects: 'projektet', process: 'si-punojme', company: 'kompania', contact: 'kontakti' };
// Built-in content; on the live site the edge replaces the marked parts with what the admin panel saved.
const site = defaultContent();
const projList = visibleProjects(site).length ? visibleProjects(site) : import.meta.env.DEV ? exampleProjects.map((p) => ({ ...p, visible: true })) : [];
const showProjects = projList.length > 0;
---
<Base lang={lang} intro>
  <header class="site-header" data-header>
    <a class="site-header__brand" href={`/${lang}/`} aria-label="EV COMPANY sh.p.k.">
      <img src="/ev-company-mark.svg" alt="" width="96" height="74" />
    </a>
    <nav class="site-nav" id="site-nav" data-nav>
      <a href={`#${ids.services}`}>{t.nav.services}</a>
      <a href={`#${ids.projects}`} data-nav-projects hidden={!showProjects}>{t.nav.projects}</a>
      <a href={`#${ids.process}`}>{t.nav.process}</a>
      <a href={`#${ids.company}`}>{t.nav.company}</a>
      <a href={`#${ids.contact}`}>{t.nav.contact}</a>
      <a class="site-nav__phone" href={contact.phoneHref} data-c-phone>{contact.phoneDisplay}</a>
    </nav>
    <div class="site-header__end">
      <div class="lang">
        <a href="/sq/" aria-current={lang === 'sq' ? 'page' : undefined} hreflang="sq" lang="sq">SQ</a>
        <a href="/en/" aria-current={lang === 'en' ? 'page' : undefined} hreflang="en" lang="en">EN</a>
      </div>
      <a class="btn btn--line site-header__call" href={contact.phoneHref}>{t.callShort}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        <span class="menu-btn__bars" aria-hidden="true"></span>
        <span class="menu-btn__text" data-open={t.menu} data-close={t.close}>{t.menu}</span>
      </button>
    </div>
  </header>

  <div class="intro-logo" aria-hidden="true" data-intro>
    <div class="intro-logo__mark" data-intro-mark>
      <img class="intro-logo__base" src="/ev-company-logo.svg" alt="" width="384" height="388" />
      <img class="intro-logo__bolt" src="/ev-bolt.svg" alt="" width="384" height="388" />
    </div>
  </div>

  <main id="main">
    <!-- HERO -->
    <section class="hero" data-hero>
      <div class="hero__stage">
        <canvas class="hero__canvas" role="img" aria-label={t.hero.canvasLabel} data-hero-canvas></canvas>
        <div class="hero__shade" aria-hidden="true"></div>
        <div class="hero__content wrap" data-hero-content>
          <div data-slot="banner"><Fragment set:html={renderBanner(lang, site)} /></div>
          <h1 class="hero__title">
            {t.hero.title.map((line) => <span class="hero__line">{line}</span>)}
          </h1>
          <p class="hero__lead">{t.hero.lead}</p>
          <div class="hero__actions">
            <a class="btn btn--glow" href={contact.phoneHref}>
              <span>{t.hero.primary}</span>
              <span class="btn__sub" data-c-phone>{contact.phoneDisplay}</span>
            </a>
            <a class="text-link" href={`#${ids.services}`}>{t.hero.secondary}</a>
          </div>
        </div>
        <div class="hero__cable" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services" id={ids.services}>
      <div class="wrap">
        <div class="section-head">
          <h2 class="h2">{t.services.title}</h2>
          <p class="section-head__lead">{t.services.lead}</p>
        </div>
        <Panel services={t.services.list} all={t.services.all} label={t.services.panelLabel} hint={t.services.hint} forLabel={t.services.forLabel} ask={t.services.ask} cityLabel={t.services.cityLabel} />
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process plan" id={ids.process} data-process>
      <div class="wrap">
        <div class="section-head">
          <h2 class="h2">{t.process.title}</h2>
          <p class="section-head__lead">{t.process.lead}</p>
        </div>
        <div class="circuit" style="--p:0">
          <svg class="circuit__wire" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="circuit__base" d="M0,20 L125,20 Q250,78 375,20 Q500,78 625,20 Q750,78 875,20 L1000,20" />
            <path class="circuit__live" d="M0,20 L125,20 Q250,78 375,20 Q500,78 625,20 Q750,78 875,20 L1000,20" pathLength="1" data-live />
          </svg>
          <span class="circuit__spark" aria-hidden="true" data-spark></span>
          <span class="circuit__vline" aria-hidden="true"><span></span></span>
          <ol class="circuit__steps">
            {t.process.steps.map(([title, text], i) => (
              <li class="circuit__step" data-step={i}>
                <span class="circuit__node" aria-hidden="true"></span>
                <span class="circuit__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="circuit__title">{title}</h3>
                <p class="circuit__text">{text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- PROJECTS (hidden until real projects exist) -->
    <div data-slot="projects"><Fragment set:html={renderProjects(lang, projList, { section: ids.projects })} /></div>

    <!-- COMPANY -->
    <section class="company plan" id={ids.company}>
      <div class="wrap company__grid">
        <h2 class="h2">{t.company.title}</h2>
        <div class="company__text">
          <p>{t.company.p1}</p>
          {t.company.p2 && <p>{t.company.p2}</p>}
        </div>
      </div>
      <blockquote class="quote wrap">
        <p>{t.company.quote}</p>
      </blockquote>
      <div class="wrap who">
        <h3 class="who__title">{t.company.whoTitle}</h3>
        <ul class="who__list">
          {t.company.who.map(([name, text]) => (
            <li><h4>{name}</h4><p>{text}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- COVERAGE -->
    <section class="coverage plan">
      <div class="wrap coverage__grid">
        <div class="coverage__text">
          <h2 class="h2">{t.coverage.title}</h2>
          <p>{t.coverage.text}</p>
          <p class="coverage__addr" data-c-address>{contact.street}, {contact.city}</p>
        </div>
        <KosovoMap base={t.coverage.base} label={t.coverage.mapLabel} />
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact" id={ids.contact} data-contact>
      <div class="wrap contact__grid">
        <div class="contact__main">
          <h2 class="h2">{t.contact.title}</h2>
          <p class="contact__lead">{t.contact.lead}</p>
          <a class="bigphone" href={contact.phoneHref} data-c-phone>{contact.phoneDisplay}</a>
          <dl class="details">
            <div><dt>{t.contact.emailLabel}</dt><dd><a href={`mailto:${contact.email}`} data-c-email>{contact.email}</a></dd></div>
            <div><dt>{t.contact.addressLabel}</dt><dd><span data-c-address>{contact.street}, {contact.city}</span><br /><a href={contact.mapsHref} target="_blank" rel="noopener" data-c-maps>{t.contact.maps}</a></dd></div>
            <div><dt>{t.contact.hoursLabel}</dt><dd data-c-hours>{t.contact.hours}</dd></div>
          </dl>
          <div class="details__social" data-slot="social"><Fragment set:html={renderSocial(site)} /></div>
        </div>
        <form class="qform" data-form data-email={contact.email} data-subject={t.contact.form.subject} data-endpoint="" data-sent={t.contact.form.sent} data-failed={t.contact.form.failed} novalidate>
          <h3 class="qform__title">{t.contact.form.title}</h3>
          <label class="field"><span>{t.contact.form.name}</span><input id="f-name" name="name" autocomplete="name" required /></label>
          <label class="field"><span>{t.contact.form.phone}</span><input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></label>
          <label class="field"><span>{t.contact.form.location}</span><input id="f-location" name="location" autocomplete="address-level2" placeholder={t.contact.form.locationPh} /></label>
          <fieldset class="field choice">
            <legend>{t.contact.form.who}</legend>
            <div class="choice__row">
              {t.contact.form.whoOptions.map((o, i) => (
                <label class="choice__opt"><input type="radio" name="who" id={`f-who-${i}`} value={o} checked={i === 0} /><span>{o}</span></label>
              ))}
            </div>
          </fieldset>
          <label class="field"><span>{t.contact.form.service}</span>
            <select id="f-service" name="service" data-service-select>
              <option value="">{t.contact.form.servicePick}</option>
              {t.services.list.map((s) => <option value={s.id}>{s.title}</option>)}
              <option value="other">{t.contact.form.other}</option>
            </select>
          </label>
          <label class="field"><span>{t.contact.form.message}</span><textarea id="f-message" name="message" rows="3" placeholder={t.contact.form.messagePh}></textarea></label>
          <button class="btn btn--dark" type="submit">{t.contact.form.submit}</button>
          <p class="qform__status" role="status" data-form-status></p>
          <p class="qform__note">{t.contact.form.note} {t.contact.form.privacyNote} <a href={`/${lang}/${L.privacy.slug}/`}>{L.labels.privacy}</a>.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <img class="footer__logo" src="/ev-company-logo.svg" alt="EV COMPANY sh.p.k." width="160" height="162" loading="lazy" />
      <p class="footer__line">{t.footer.line}</p>
      <nav class="footer__nav" aria-label={t.menu}>
        <a href={`#${ids.services}`}>{t.nav.services}</a>
        <a href={`#${ids.projects}`} data-nav-projects hidden={!showProjects}>{t.nav.projects}</a>
        <a href={`#${ids.process}`}>{t.nav.process}</a>
        <a href={`#${ids.company}`}>{t.nav.company}</a>
        <a href={`#${ids.contact}`}>{t.nav.contact}</a>
      </nav>
      <div class="footer__contact">
        <a href={contact.phoneHref} data-c-phone>{contact.phoneDisplay}</a>
        <a href={`mailto:${contact.email}`} data-c-email>{contact.email}</a>
        <span data-c-address>{contact.street}, {contact.city}</span>
        <div data-slot="social"><Fragment set:html={renderSocial(site)} /></div>
      </div>
    </div>
    <div class="wrap footer__base">
      <span>© {year} EV COMPANY sh.p.k. {t.footer.rights}</span>
      <nav class="legal-links" aria-label={L.labels.privacy}>
        <a href={`/${lang}/${L.privacy.slug}/`}>{L.labels.privacy}</a>
        <a href={`/${lang}/${L.terms.slug}/`}>{L.labels.terms}</a>
      </nav>
      <span class="footer__preview">{t.footer.preview}</span>
      <a href="#main">{t.footer.top}</a>
    </div>
  </footer>

  <nav class="mobilebar" aria-label={t.callShort} data-mobilebar>
    <a class="mobilebar__call" href={contact.phoneHref}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      {t.callShort}
    </a>
    <a class="mobilebar__quote" href={`#${ids.contact}`}>{t.contact.form.title}</a>
    <span class="mobilebar__slot" data-slot="mobile-chat"><Fragment set:html={renderMobileChat(site)} /></span>
  </nav>

  <script>
    import { boot } from '../../scripts/main';
    boot();
  </script>
</Base>
