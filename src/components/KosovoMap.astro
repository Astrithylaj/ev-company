---
// Dot map of Kosovo (Natural Earth 1:10m outline, generated by scripts/kosovo.mjs).
import data from '../data/kosovo.json';
interface Props { base: string; label: string }
const { base, label } = Astro.props;
const [px, py] = data.prishtina;
const maxD = Math.max(...data.dots.map(([x, y]) => Math.hypot(x - px, y - py)));
const dots = data.dots.map(([x, y]) => {
  const d = Math.hypot(x - px, y - py) / maxD; // 0 at Prishtina, 1 at the farthest border
  return { x, y, d: Math.round(d * 1000) / 1000 };
});
const towns = (data.towns ?? []).map(([name, x, y]) => ({ name: String(name), x: Number(x), y: Number(y), d: Math.round((Math.hypot(Number(x) - px, Number(y) - py) / maxD) * 1000) / 1000 }));
// where each town name sits relative to its light, so neighbours never overlap: [dx, dy, anchor]
const place: Record<string, [number, number, string]> = {
  Ferizaj: [-9, 4, 'end'], Suharekë: [0, 19, 'middle'], Vushtrri: [9, 13, 'start'], Mitrovicë: [-9, 4, 'end'],
  Skenderaj: [-9, 4, 'end'], Istog: [0, -10, 'middle'], Kamenicë: [0, -10, 'middle'], Gjilan: [9, 4, 'start'],
};
const tl = (t: { name: string; x: number; y: number }) => { const [dx, dy, a] = place[t.name] ?? [9, 4, 'start']; return { x: t.x + dx, y: t.y + dy, a }; };
---
<figure class="kmap" data-kmap>
  <svg viewBox={`0 0 ${data.w} ${data.h}`} role="img" aria-label={label}>
    <path class="kmap__outline" d={data.outline} />
    <g class="kmap__dots">
      {dots.map((p) => <circle cx={p.x} cy={p.y} r="3.1" style={`--d:${p.d}`} />)}
    </g>
    <g class="kmap__towns" aria-hidden="true">
      {towns.map((t) => <circle class="kmap__town" cx={t.x} cy={t.y} r="4.6" style={`--d:${t.d}`}><title>{t.name}</title></circle>)}
      {towns.map((t) => { const l = tl(t); return <text class="kmap__townlabel" x={l.x} y={l.y} text-anchor={l.a} style={`--d:${t.d}`}>{t.name}</text>; })}
    </g>
    <g class="kmap__base" transform={`translate(${px} ${py})`}>
      <circle class="kmap__ring" r="14" />
      <circle class="kmap__ring kmap__ring--2" r="14" />
      <circle class="kmap__core" r="7" />
    </g>
    <text class="kmap__label" x={px + 18} y={py - 16}>{base}</text>
  </svg>
</figure>
